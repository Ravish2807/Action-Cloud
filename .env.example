# Copy to .env and adjust. Never commit the real .env.

# --- Postgres ---------------------------------------------------------------
DB_HOST=127.0.0.1
# 5433, not 5432 — see docker-compose.yml. Avoids colliding with a Postgres
# installed natively on the host.
DB_PORT=5433
DB_NAME=actioncloud
DB_USER=actioncloud
DB_PASSWORD=actioncloud

# --- Queue ------------------------------------------------------------------
AWS_REGION=us-east-1
QUEUE_NAME=actioncloud-experiences
# In AWS, point this at a JSON Secrets Manager secret (for example the RDS
# managed master-user secret). Leave unset for local dotenv configuration.
# AWS_SECRETS_MANAGER_ARN=

# Point at LocalStack for local dev. DELETE this line when running on real AWS
# so boto3 resolves the genuine SQS endpoint.
AWS_ENDPOINT_URL=http://localhost:4566

# LocalStack ignores these but boto3 refuses to start without something set.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Behaviour --------------------------------------------------------------
EMBEDDING_DIM=1536
# Optional local sentence-transformers model (`pip install -e '.[minilm]'`);
# requires a database created with vector(384) and EMBEDDING_DIM=384.
# EMBEDDING_PROVIDER=minilm

# Process writes in-request instead of via SQS + worker. The same ingest
# pipeline runs either way. Use true for a single-user MCP setup (no
# LocalStack needed); keep false to exercise the queued production path.
SYNC_WRITE=false

# A full URL overrides the DB_* fields above (handy in MCP client configs).
# DATABASE_URL=postgresql://actioncloud:actioncloud@localhost:5433/actioncloud

# --- Auth ---------------------------------------------------------------------
# REST callers must send an agent API key (X-API-Key); identity comes from the
# key. Issue keys with `make agent ID=<id> ROLE=<role>` or POST /agents.
AUTH_REQUIRED=true
# Admin key for POST/DELETE /agents. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# ACTIONCLOUD_ADMIN_KEY=
# The MCP server / HTTP client act as the agent owning this key.
# ACTIONCLOUD_API_KEY=

# --- Models -------------------------------------------------------------------
# Embeddings: hashing (default, offline, lexical) | gemini | openai.
# Switching provider changes the vector space: `make reset` and re-run
# scripts/calibrate_threshold.py.
EMBEDDING_PROVIDER=hashing
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Agent LLM for scripts: sim (simulated, offline) | mock | anthropic | gemini | groq
LLM_PROVIDER=sim
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# AWS deployments may set one or more comma-separated JSON secret ARNs.
# Local deployments normally leave this blank and use DB_* above.
AWS_SECRETS_MANAGER_ARN=
# Optional bearer token required by /metrics/prometheus when set.
PROMETHEUS_METRICS_TOKEN=

# --- Retrieval policy (defaults shown) ---------------------------------------
# MEMORY_CANDIDATE_K=10
# MEMORY_MAX_CONTEXT_MEMORIES=1
# MEMORY_SIMILARITY_THRESHOLD=0.30
# MEMORY_MIN_CONFIDENCE=0.45
# MEMORY_CONTEXT_TOKEN_BUDGET=1000
