# Secrets — never commit
.env

# Terraform state, provider cache and user-specific variables
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
infra/terraform/backend.tf
infra/terraform/crash.log
.tools/

# Python
__pycache__/
*.py[cod]
.venv/
.dashboard-venv/
venv/
*.egg-info/
.pytest_cache/

# Experiment output: results/ IS versioned — it holds the run the README
# cites (make experiment). Scratch runs: pass --out somewhere else.
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
